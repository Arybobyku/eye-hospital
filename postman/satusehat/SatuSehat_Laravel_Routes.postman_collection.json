                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/satusehat/location",
              "host": ["{{base_url}}"],
              "path": ["satusehat", "location"]
            },
            "description": "Ambil daftar Location (poli/ruangan) milik faskes menggunakan org ID dari `.env`."
          },
          "response": []
